# ===== 模型A（生成）=====
MODEL_A_NAME=deepseek-v4-pro
MODEL_A_BASE_URL=https://api.deepseek.com/v1
MODEL_A_API_KEY=

# ===== 模型B（反思/评审）—— 物理隔离：独立配置，可指向另一个模型 =====
# 这是从 HELLO 复盘的待优化点「双模型物理同源」的落地：模型B 可单独换 Ollama/其他厂商
# 示例用 deepseek-v4-flash（与 A 不同模型 = 评审不是自己评自己）
MODEL_B_NAME=deepseek-v4-flash
MODEL_B_BASE_URL=https://api.deepseek.com/v1
MODEL_B_API_KEY=

# ===== LLM 通用 =====
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ===== embedding（双后端：sentence-transformers / ollama）=====
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 检索 =====
TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
USE_DENSE_RETRIEVAL=true
# 空=不重排；填 BAAI/bge-reranker-base 开启 cross-encoder 精排
RAG_CROSS_ENCODER=
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# ===== Qdrant（本地嵌入式，无需 Docker；想用服务端填 URL）=====
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=knowledge_base
QDRANT_URL=

# ===== 记忆 =====
SQLITE_MEMORY_PATH=./memory.db
MEMORY_EPISODIC_COLLECTION=agent_memory_episodic
MEMORY_TOP_K=3
MEMORY_TTL_DAYS=30
MEMORY_IMPORTANCE_WEIGHT=0.5

# ===== 安全 =====
SAFETY_ENABLED=true
SAFETY_SENSITIVE_WORDS=

# ===== 工具白名单（售后业务工具；未纳入的工具不允许执行）=====
TOOL_WHITELIST=safety_check,query_order,query_logistics,apply_refund,web_search
# True 时 tools_node 优先走 bind_tools Function Calling，失败退回启发式路由
TOOL_USE_FUNCTION_CALLING=false

# ===== 可选：联网搜索 =====
TAVILY_API_KEY=
